# -------------------------
# Shared backend settings
# -------------------------
PORT=8787
# Use a long random value in production. It is used when hashing the extension's random installation ID.
SAFETY_ID_SALT=replace-with-a-long-random-secret
# Comma-separated origins for production, for example:
# ALLOWED_ORIGINS=chrome-extension://your-extension-id,https://your-admin-site.example
ALLOWED_ORIGINS=*

# -------------------------
# OpenAI Realtime provider
# -------------------------
# Leave blank if you only want the local Ollama provider.
OPENAI_API_KEY=

# -------------------------
# Local Ollama provider
# -------------------------
LOCAL_PIPELINE_ENABLED=true
OLLAMA_URL=http://127.0.0.1:11434
# Optional preferred model. If blank, the extension selects the first model returned by Ollama.
OLLAMA_MODEL=translategemma:latest

# whisper.cpp: build whisper-cli and download a multilingual ggml model.
WHISPER_COMMAND=./whisper.cpp/build/bin/whisper-cli
WHISPER_MODEL_PATH=./whisper.cpp/models/ggml-large-v3-turbo.bin

# Optional extra whisper-cli arguments, for example: -t 8
# WHISPER_EXTRA_ARGS=--vad --vad-model /Users/ananthuanil/Documents/Projects/ATV/server/whisper.cpp/models/ggml-silero-v6.2.0.bin --vad-speech-pad-ms 250 --vad-samples-overlap 0.20

# ffmpeg is used to convert browser WebM/Opus chunks to 16 kHz mono PCM WAV.
FFMPEG_PATH=ffmpeg

# Piper is optional and required only for local dubbing. The defaults use the current Python CLI.
PIPER_COMMAND=python
PIPER_COMMAND_ARGS=-m piper
# Map target language codes to installed Piper voice names or model paths.
# Example after: python -m piper.download_voices en_US-lessac-medium
PIPER_VOICES_JSON={"en":"en_US-lessac-medium"}
# For multiple languages, use a JSON object with language codes as keys and voice names or model paths as values.
# PIPER_VOICES_JSON={"en":"en_US-lessac-medium","de":"de_DE-thorsten-medium"}

# Maximum time allowed for local ffmpeg, whisper.cpp, Ollama, or Piper work on one chunk.
LOCAL_COMMAND_TIMEOUT_MS=90000

# -------------------------
# Debugging and development settings
# -------------------------
# Enable verbose logging for debugging.
DEBUG_LOGGING=true
